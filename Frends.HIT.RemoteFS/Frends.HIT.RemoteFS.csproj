<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <authors>Höglandets IT</authors>
        <copyright>Copyright © 2022 Höglandets IT</copyright>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Hoglandets-IT/Frends.HIT.RemoteFS</PackageProjectUrl>
        <Description>Cross-platform tasks for managing remote filesystems (FTP, SFTP, SMB)</Description>
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSource>True</IncludeSource>
        <PackageTags>Frends</PackageTags>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Frends.HIT.RemoteFS</PackageId>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/Hoglandets-IT/Frends.HIT.RemoteFS</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="FrendsTaskMetadata.json" Pack="true" PackagePath="/">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
        <PackageReference Include="SSH.NET" Version="2026.0.0" />
        <PackageReference Include="FluentFTP" Version="55.0.0" />
        <PackageReference Include="EzSmb" Version="1.3.10" />
        <PackageReference Include="VaultSharp" Version="1.17.5.1" />
        <PackageReference Include="Genbox.SimpleS3.GenericS3" Version="3.2.14" />
        <PackageReference Include="AWSSDK.S3" Version="4.0.103.3" />
    </ItemGroup>
    
</Project>
